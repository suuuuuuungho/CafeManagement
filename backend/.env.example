# Local dev default is SQLite; point this at Neon's Postgres URL for staging/prod.
# Neon gives you a postgresql:// URL — swap the scheme to postgresql+asyncpg://
DATABASE_URL=sqlite+aiosqlite:///./cafe.db

JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173

DEPOSIT_MATCH_WINDOW_MINUTES=30
