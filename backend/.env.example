# Local dev default is SQLite; point this at Neon's Postgres URL for staging/prod.
# Neon gives you a postgresql:// URL — swap the scheme to postgresql+asyncpg://
#
# Use the DIRECT connection string (host WITHOUT "-pooler" in it), not the
# pooled one. Neon's pooled endpoint goes through PgBouncer in transaction
# mode, whose own backend sessions can end up with a stale query plan after
# a schema change — every later request that happens to land on that same
# pooled session then fails with "cached statement plan is invalid" /
# "cache lookup failed for type NNNNN", and it doesn't self-heal from our
# side since the problem lives in PgBouncer's session, not our connection.
DATABASE_URL=sqlite+aiosqlite:///./cafe.db

JWT_SECRET=change-me-to-a-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Comma-separated allowed frontend origins
CORS_ORIGINS=http://localhost:5173

DEPOSIT_MATCH_WINDOW_MINUTES=30
